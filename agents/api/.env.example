# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your_api_key_here

# Any OpenAI-compatible gateway. Defaults to Groq.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # then use an OpenRouter key above

# Exa web API key. Required for runs with tools="exa"; leave unset to use only
# the local Chromium backend.
# EXA_API_KEY=

# Set to false to watch the Playwright Chromium window during runs.
# Default is headless (no window).
# BROWSER_HEADLESS=false

# Listen port (docker compose also maps 3000).
# PORT=3000
