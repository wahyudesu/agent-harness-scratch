OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=base_url
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1   # then use an OpenRouter key above

# EXA_API_KEY=

# Set to false to watch the Playwright Chromium window during runs.
# Default is headless (no window).
# BROWSER_HEADLESS=false

# Listen port (docker compose also maps 3000).
# PORT=3000

# Bearer token that bypasses API rate limiting. Clients sending
# `Authorization: Bearer <token>` skip the /api/* limiters entirely.
# API_TOKEN=
